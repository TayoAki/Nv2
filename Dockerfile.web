# The Nyoni web app on Railway (RAILWAY_DOCKERFILE_PATH=Dockerfile.web), built from the
# repository root. EXPO_PUBLIC_API_URL comes from .env and is baked in at build time.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npx expo export --platform web --clear

FROM node:22-alpine
RUN npm install -g serve@14.2.4
COPY --from=build /app/dist /site
USER node
# -s: every route (/shop, /product/…, /admin) serves index.html so the app's router handles it.
CMD ["sh", "-c", "serve -s /site -l tcp://0.0.0.0:${PORT:-8080} --no-clipboard"]
